# Build output / deps / caches
dist/
.astro/
node_modules/
__pycache__/
*.pyc
.DS_Store
.direnv/
result

# Local Claude Code settings
.claude/

# ---- Images / plots: NEVER versioned (anywhere) ----
*.jpg
*.jpeg
*.png
*.xcf
*.dzi

# Exception: self-hosted third-party libs/fonts are vendored so the site build
# is self-contained (no runtime CDN dependency). Track everything under vendor/,
# including its PNG sprites, overriding the *.png rule above.
!web/public/vendor/**

# ---- Raw scans + GIMP master (all images) ----
data/raw/

# ---- Large / regenerable pipeline artifacts (NOT the toponym JSONs) ----
# Detection intermediates: tiles, per-tile JSON, detections, Approach-B windows.
data/toponims/mapkurator/
# NGIB gazetteer corpus (~36k rows) — regenerable with ngib-fetch.mjs.
data/toponims/ngib/
# GCP + review crops (images) and overlays.
data/toponims/gcp-crops/
data/toponims/review-crops/
# Curation atomic-write artefacts (rolling .bak/.tmp on every save).
data/toponims/curation.json.bak
data/toponims/curation.json.tmp

# The curated toponym data — data/toponims/*.json (toponims, matches, recheck,
# gcps, curation, quality_flags, …) — IS versioned (small, the human work).

# ---- Web generated data + visual assets (built by `npm run data`/`hero`/`map`) ----
web/src/data/
web/public/hero/*
# Exception: the built hero image IS versioned. Its source is a raw scan
# (data/raw/, intentionally unversioned), so CI cannot regenerate it and the
# deploy needs it present. Mirrors the web/public/vendor/** exception above.
!web/public/hero/mapa-hero.jpg
# The built deep-zoom map (web/public/map: mapa.dzi + 255 tiles) IS versioned.
# It is generated from an unversioned raw scan, so a clean CI checkout (or any
# other machine) cannot rebuild it; committing it keeps the repo self-contained
# and auto-deployable. Public-domain source. Overrides the *.jpeg/*.dzi rules.
!web/public/map/**
web/public/vinetes/
web/public/sheets/

# Regenerable reports (not core data)
data/toponims/review-data.json
data/toponims/quality_report.json
