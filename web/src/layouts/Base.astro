---
import '../styles/global.css';
import { url } from '../lib/url.mjs';

const { title, description } = Astro.props;
const fullTitle = title ? `${title} · Mapa de Mallorca de Vicenç Mut (1683)` : 'El mapa de Mallorca de Vicenç Mut (1683)';
const desc = description ?? "Els topònims del mapa de Mallorca de Vicenç Mut, Insula Maioricae, gravat el 1683.";

const path = Astro.url.pathname.replace(/\/$/, '');
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const nav = [
  { href: url(''), label: 'Inici', match: base === '' ? '' : base },
  { href: url('gravat'), label: 'El gravat', match: base + '/gravat' },
  { href: url('toponims'), label: 'Topònims', match: base + '/toponims' },
  { href: url('mapa'), label: 'Mapa', match: base + '/mapa' },
  { href: url('estadistiques'), label: 'Estadístiques', match: base + '/estadistiques' },
  { href: url('metode'), label: 'El mètode', match: base + '/metode' },
];
const isCurrent = (m) => (m === (base || '') ? path === (base || '') : path === m || path.startsWith(m + '/'));

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://mut.corpusbalear.org/#website',
      url: 'https://mut.corpusbalear.org/',
      name: 'Mapa de Mallorca de Vicenç Mut (1683)',
      inLanguage: 'ca',
      isPartOf: { '@type': 'CollectionPage', name: 'Corpus Balear', url: 'https://corpusbalear.org/' },
    },
    {
      '@type': 'Dataset',
      '@id': 'https://mut.corpusbalear.org/#dataset',
      name: 'Topònims del mapa de Vicenç Mut (Insula Maioricae, 1683)',
      description:
        'Lectura, identificació i georeferenciació dels topònims gravats al mapa de Mallorca de Vicenç Mut (1683), enllaçats al Nomenclàtor Geogràfic de les Illes Balears (NGIB).',
      inLanguage: 'ca',
      creator: { '@type': 'Person', name: 'Antonio Picornell' },
      license: 'https://creativecommons.org/licenses/by-nc/4.0/',
      isBasedOn: { '@type': 'Map', name: 'Insula Maioricae', creator: { '@type': 'Person', name: 'Vicenç Mut' }, datePublished: '1683' },
      isPartOf: { '@type': 'CollectionPage', name: 'Corpus Balear', url: 'https://corpusbalear.org/' },
      spatialCoverage: { '@type': 'Place', name: 'Mallorca' },
    },
  ],
};
---
<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <link rel="stylesheet" href={url('vendor/fonts/fonts.css')} />
  </head>
  <body>
    <a href="#main" class="skip">Salta al contingut</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('')}>Mapa de Mallorca · Vicenç Mut · 1683</a>
        <nav class="nav" aria-label="Principal">
          {nav.map((n) => (
            <a href={n.href} aria-current={isCurrent(n.match) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <em>Insula Maioricae</em> (Vicenç Mut, gravat el 1683), enllaçat al
          <em>Nomenclàtor Geogràfic de les Illes Balears</em> (NGIB) com a autoritat de topònims canònics.
          <br />
          Dades dels topònims © Antonio Picornell ·
          <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="noopener">CC BY-NC 4.0</a>
          (reutilització no comercial amb atribució).
          <br />
          Part del <a href="https://corpusbalear.org/">Corpus Balear</a> · edicions digitals de fonts històriques de les Illes Balears.
        </div>
        <div class="foot-links">
          <a href="https://github.com/acpicornell/mapa-mut" target="_blank" rel="noopener">
            <svg class="gh" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            Codi al repositori
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
